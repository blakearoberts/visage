{
  "name": "@blakearoberts/visage-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspace packages --if-present",
    "check": "npm run check:format && npm run check:type",
    "check:format": "prettier --check .",
    "check:type": "npm run typecheck --workspaces",
    "format": "prettier --write .",
    "pretest:e2e": "npm run build",
    "precheck:type": "npm run build",
    "test": "npm run test --workspace packages --if-present",
    "test:e2e": "npm run test:e2e --workspace packages --if-present"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
