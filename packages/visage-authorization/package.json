{
  "name": "@blakearoberts/visage-authorization",
  "version": "0.0.1",
  "description": "Lean RFC 8693 token exchange authorization server for Node.js with OPA policy decisions.",
  "type": "module",
  "author": "Blake Roberts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/blakearoberts/visage.git",
    "directory": "packages/visage-authorization"
  },
  "bugs": {
    "url": "https://github.com/blakearoberts/visage/issues"
  },
  "homepage": "https://github.com/blakearoberts/visage#readme",
  "keywords": [
    "authorization",
    "oauth2",
    "opa",
    "rfc8693",
    "token-exchange"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "rollup -c",
    "check": "npm run typecheck",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "jose": "^6.2.8"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.1.2",
    "rollup": "^4.62.4",
    "tslib": "^2.8.1",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3"
  }
}
