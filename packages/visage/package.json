{
  "name": "@blakearoberts/visage",
  "version": "0.0.6",
  "description": "Vite plugin for local development with HMR and OIDC session cookie lifecycle semantics.",
  "type": "module",
  "author": "Blake Roberts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/blakearoberts/visage.git",
    "directory": "packages/visage"
  },
  "bugs": {
    "url": "https://github.com/blakearoberts/visage/issues"
  },
  "homepage": "https://github.com/blakearoberts/visage#readme",
  "keywords": [
    "authentication",
    "hmr",
    "local-development",
    "oauth2",
    "oidc",
    "pkce",
    "session-cookie",
    "vite",
    "vite-plugin"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docker-compose.images.yml",
    "otelcol"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pretest:e2e": "npm run build",
    "test": "node --test test/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc && tsc -p nginx"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "eta": "^4.6.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "njs-types": "^1.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
